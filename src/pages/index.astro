---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Countdown from '../components/Countdown.astro';
import VideoReel from '../components/VideoReel.astro';
import Carousel from '../components/Carousel.astro';
import EventPhotoCard from '../components/EventPhotoCard.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import ExternalLink from '../components/ExternalLink.astro';
import logo from '../assets/brand/logo.png';
import paws from '../assets/brand/tiger-paws.png';
import { getEvents } from '../lib/events';
import { site } from '../data/site';

const { upcoming, past } = await getEvents();
const collabs = past.filter((e) => e.kind === 'collab');
const nights = past.filter((e) => e.kind !== 'collab');
---

<Base intro>
  <Intro slot="intro" />

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <Image src={logo} alt="Baking Bad logo: a tiger cub holding a whisk, since 2025" width={300} height={308} class="hero-logo" loading="eager" fetchpriority="high" />
        <h1>{site.tagline}.</h1>
        <p class="lede">Themed bake nights, cultural collabs, free baked goods. No experience needed.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/join/">Join us</a>
          <ExternalLink class="btn btn-ghost" href={site.instagram.url}>{site.instagram.handle}</ExternalLink>
        </div>
      </div>
      <Countdown events={upcoming} />
    </div>
  </section>

  <div class="wrap stack">
    <VideoReel />

    {
      collabs.length > 0 && (
        <Carousel id="collabs" title="Collabs" subtitle="Campus groups teach us a recipe from home. Tap for photos.">
          {collabs.map((e) => <EventPhotoCard event={e} />)}
        </Carousel>
      )
    }

    {
      nights.length > 0 && (
        <Carousel id="nights" title="Bake nights" subtitle="Movie themes, holidays, and whatever's in season." speed={26}>
          {nights.map((e) => <EventPhotoCard event={e} />)}
        </Carousel>
      )
    }

    <a class="join-band" href="/join/">
      <Image src={paws} alt="" width={160} class="peek" />
      <span>
        <strong>New here?</strong> Here's how to join, where we bake, and what to expect.
      </span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <PhotoViewer events={past} />
</Base>

<style>
  .hero { padding: clamp(28px, 5vw, 56px) 0 0; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
  }
  .hero-logo {
    width: clamp(110px, 14vw, 150px);
    height: auto;
    margin-bottom: 14px;
    filter: drop-shadow(0 10px 18px rgb(168 116 72 / 0.25));
  }
  h1 { max-width: 16ch; margin-bottom: 0.3em; }
  .lede { max-width: 42ch; margin-bottom: 22px; font-size: 1.1rem; color: var(--ink-soft); }

  .stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* let carousels scroll instead of widening the page */
    gap: clamp(48px, 7vw, 80px);
    padding-top: clamp(48px, 7vw, 80px);
  }
  .hero-grid > :global(*) { min-width: 0; }

  .join-band {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    padding: 22px 26px 22px 150px;
    border-radius: calc(var(--radius) + 6px);
    background: var(--apricot);
    color: var(--ink);
    font-size: 1.08rem;
    text-decoration: none;
    transition: transform 0.2s var(--ease-out);
  }
  .join-band:hover { transform: translateY(-3px); }
  .join-band strong { font-weight: 900; }
  .arrow { margin-left: auto; font-size: 1.4rem; font-weight: 900; }
  .peek {
    position: absolute;
    left: 24px;
    bottom: 0;
    width: 104px;
    height: auto;
  }

  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-text { text-align: center; }
    .hero-logo { margin-inline: auto; }
    h1, .lede { margin-inline: auto; }
    .btn-row { justify-content: center; }
  }
  @media (max-width: 560px) {
    .join-band { padding: 96px 20px 20px; flex-direction: column; text-align: center; }
    .arrow { display: none; }
    .peek { left: 50%; top: -24px; bottom: auto; transform: translateX(-50%); width: 96px; }
  }
</style>
