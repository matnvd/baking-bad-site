---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import paws from '../assets/brand/tiger-paws.png';
import { site } from '../data/site';
---

<Base title="Join" description="How to join Baking Bad, Princeton's all-inclusive student baking club: where we bake, how it works, and who to contact.">
  <section class="section top">
    <div class="wrap head">
      <div>
        <p class="pill">Everyone's welcome</p>
        <h1>Join Baking Bad</h1>
        <p class="lede">
          Learn the art and science of baking, meet people who love it too, and take home free baked goods. Come bake and
          destress with us. Bring your friends!
        </p>
      </div>
      <Image src={paws} alt="" width={260} class="head-tiger" />
    </div>
  </section>

  <section class="wrap" aria-labelledby="steps">
    <h2 id="steps">Joining, in four steps</h2>
    <ol class="steps">
      <li>
        <span class="num" aria-hidden="true">1</span>
        <div>
          <h3>Say hi</h3>
          <p>
            Join the <ExternalLink href={site.groupme}>GroupMe</ExternalLink> and follow{' '}
            <ExternalLink href={site.instagram.url}>{site.instagram.handle}</ExternalLink> for bake announcements.
          </p>
        </div>
      </li>
      <li>
        <span class="num" aria-hidden="true">2</span>
        <div>
          <h3>Pick a bake</h3>
          <p>The <a href="/">countdown on the home page</a> always shows what's next.</p>
        </div>
      </li>
      <li>
        <span class="num" aria-hidden="true">3</span>
        <div>
          <h3>Sign up</h3>
          <p>With a friend, if you like! No experience needed.</p>
        </div>
      </li>
      <li>
        <span class="num" aria-hidden="true">4</span>
        <div>
          <h3>Claim a workspace</h3>
          <p>Grab a spot and do it all: whisk, roll, decorate, and taste-test.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="section" aria-labelledby="know">
    <div class="wrap">
      <h2 id="know">Good to know</h2>
      <dl class="facts">
        <div class="card">
          <dt>How it works</dt>
          <dd>We bake 2–3 times a month, each month around a dessert theme.</dd>
        </div>
        <div class="card">
          <dt>Where</dt>
          <dd>{site.kitchens.join(' or ')}. Each event lists its kitchen.</dd>
        </div>
        <div class="card">
          <dt>Dietary needs</dt>
          <dd>We try to cover gluten-free, vegan, and nut-free. Just let us know.</dd>
        </div>
        <div class="card">
          <dt>Bake your way</dt>
          <dd>Follow the recipe, follow an officer, or freestyle. Be your own baker.</dd>
        </div>
        <div class="card">
          <dt>Questions?</dt>
          <dd>
            Email <a href={`mailto:${site.email}`}>{site.email}</a> or DM{' '}
            <ExternalLink href={site.instagram.url}>{site.instagram.handle}</ExternalLink>.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .top { padding-bottom: 24px; }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .head h1 { margin-top: 14px; }
  .lede { max-width: 58ch; margin: 0; font-size: 1.1rem; color: var(--ink-soft); }
  :global(.head-tiger) { width: clamp(110px, 18vw, 160px); height: auto; flex: none; }

  h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    display: flex;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .steps h3 { margin: 4px 0 2px; font-size: 1.05rem; }
  .steps p { margin: 0; font-size: 0.95rem; color: var(--ink-soft); }
  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--apricot);
    font-weight: 900;
    -webkit-mask: url('/scallop.svg') center / 100% 100% no-repeat;
    mask: url('/scallop.svg') center / 100% 100% no-repeat;
  }
  .steps li:nth-child(2) .num { background: var(--coral); }
  .steps li:nth-child(3) .num { background: var(--blush); }
  .steps li:nth-child(4) .num { background: #fde3c8; }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 14px;
    margin: 18px 0 0;
  }
  .facts .card { padding: 18px 20px; }
  dt { font-weight: 900; margin-bottom: 4px; }
  dd { margin: 0; font-size: 0.95rem; color: var(--ink-soft); }

  @media (max-width: 960px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .head { flex-direction: column-reverse; align-items: flex-start; }
    .steps { grid-template-columns: 1fr; }
  }
</style>
