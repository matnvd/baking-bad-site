---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import paws from '../assets/brand/tiger-paws.png';
import { site } from '../data/site';
// Simple line icons for the "Good to know" cards (24×24, drawn with currentColor).
const icons = {
  calendar:
    '<rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="M12 17.2l-2.2-2.1a1.3 1.3 0 0 1 2.2-1.4 1.3 1.3 0 0 1 2.2 1.4z" fill="currentColor" stroke="none"/>',
  pin: '<path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0c0 5.2-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
  leaf: '<path d="M19.5 4.5C10.5 4.5 5 9.5 5 15.6c0 1.7.5 3.1 1.4 3.9 6.6 0 13.1-5 13.1-15z"/><path d="M6.4 19.5c2.8-4.4 6.2-7.8 9.6-10"/>',
  chefHat:
    '<path d="M7.5 17.5v-4.2a3.6 3.6 0 0 1-1.2-6.8 4.1 4.1 0 0 1 5.7-2.4 4.1 4.1 0 0 1 5.7 2.4 3.6 3.6 0 0 1-1.2 6.8v4.2z"/><path d="M7.5 17.5h9v2.2a.8.8 0 0 1-.8.8H8.3a.8.8 0 0 1-.8-.8z"/><path d="M10.5 13.5v4M13.5 13.5v4"/>',
  chat: '<path d="M6 4.5h12a2.5 2.5 0 0 1 2.5 2.5v8a2.5 2.5 0 0 1-2.5 2.5h-6.5l-4.5 3.5v-3.5H6A2.5 2.5 0 0 1 3.5 15V7A2.5 2.5 0 0 1 6 4.5z"/><circle cx="8.5" cy="11" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="11" r="1" fill="currentColor" stroke="none"/><circle cx="15.5" cy="11" r="1" fill="currentColor" stroke="none"/>',
};
---

<Base title="Join" description="How to join Baking Bad, Princeton's all-inclusive student baking club: where we bake, how it works, and who to contact.">
  <section class="section top">
    <div class="wrap head">
      <div>
        <p class="pill">Everyone's welcome</p>
        <h1>Join Baking Bad</h1>
        <p class="lede">
          Learn the art and science of baking, meet people who love it too, and take home free baked goods. Come bake and
          destress with us. Bring your friends!
        </p>
      </div>
      <Image src={paws} alt="" width={260} class="head-tiger" />
    </div>
  </section>

  <section class="wrap" aria-labelledby="steps">
    <h2 id="steps">Joining, in three steps</h2>
    <ol class="steps">
      <li>
        <span class="num" aria-hidden="true">1</span>
        <div>
          <h3>Say hi and ask questions!</h3>
          <p>
            Join the <ExternalLink href={site.groupme}>GroupMe</ExternalLink> for the latest updates and also follow{' '}
            <ExternalLink href={site.instagram.url}>{site.instagram.handle}</ExternalLink> on Instagram for announcements and recaps.
          </p>
        </div>
      </li>
      <li>
        <span class="num" aria-hidden="true">2</span>
        <div>
          <h3>Sign up!?</h3>
          <p>
            Sign-ups for the next bake will drop live <a href="/">here</a> on the site (limited spots so be fast!). Sign-up with a friend or pair with someone the night of.
          </p>
        </div>
      </li>
      <li>
        <span class="num" aria-hidden="true">3</span>
        <div>
          <h3>Start baking :)</h3>
          <p>Grab a spot and do it all: whisk, roll, decorate, and taste-test. We'll provide the recipes, ingredients, and experienced bake leads; you have fun!</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="section" aria-labelledby="know">
    <div class="wrap">
      <h2 id="know">Good to know</h2>
      <dl class="facts">
        <div class="card fact">
          <dt><span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons.calendar} /></span>How it works</dt>
          <dd>We bake 2–3 times a month, each month around a dessert theme.</dd>
        </div>
        <div class="card fact">
          <dt><span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons.pin} /></span>Where</dt>
          <dd>{site.kitchens.join(' or ')}. Each event lists its kitchen.</dd>
        </div>
        <div class="card fact">
          <dt><span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons.leaf} /></span>Dietary needs</dt>
          <dd>We try to cover gluten-free, vegan, and nut-free. Just let us know.</dd>
        </div>
        <div class="card fact">
          <dt><span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chefHat} /></span>Bake your way</dt>
          <dd>Follow the recipe, follow an officer, or freestyle. Be your own baker.</dd>
        </div>
        <div class="card fact">
          <dt><span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chat} /></span>Questions?</dt>
          <dd>
            Email <ExternalLink href={`mailto:${site.email}`}>{site.email}</ExternalLink> or DM{' '}
            <ExternalLink href={site.instagram.url}>{site.instagram.handle}</ExternalLink>.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .top { padding-bottom: 24px; }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .head h1 { margin-top: 14px; }
  .lede { max-width: 58ch; margin: 0; font-size: 1.1rem; color: var(--ink-soft); }
  :global(.head-tiger) { width: clamp(110px, 18vw, 160px); height: auto; flex: none; }

  h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    display: flex;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .steps h3 { margin: 4px 0 2px; font-size: 1.05rem; }
  .steps p { margin: 0; font-size: 0.95rem; color: var(--ink-soft); }
  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--apricot);
    font-family: var(--font-display); font-weight: 700;
    -webkit-mask: url('/scallop.svg') center / 100% 100% no-repeat;
    mask: url('/scallop.svg') center / 100% 100% no-repeat;
  }
  .steps li:nth-child(2) .num { background: var(--coral); }
  .steps li:nth-child(3) .num { background: var(--blush); }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 14px;
    margin: 18px 0 0;
  }
  .facts .card { padding: 18px 20px; }
  /* icon badge on the left, same scalloped shape and colors as the step numbers */
  .fact { position: relative; padding-left: 80px !important; min-height: 84px; }
  .icon {
    position: absolute;
    left: 20px;
    top: 18px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--ink);
    background: var(--apricot);
    -webkit-mask: url('/scallop.svg') center / 100% 100% no-repeat;
    mask: url('/scallop.svg') center / 100% 100% no-repeat;
  }
  .fact:nth-child(5n + 2) .icon { background: var(--coral); }
  .fact:nth-child(5n + 3) .icon { background: var(--blush); }
  .fact:nth-child(5n + 4) .icon { background: #fde3c8; }
  .fact:nth-child(5n + 5) .icon { background: var(--apricot); }
  dt { font-family: var(--font-display); font-weight: 700; margin-bottom: 4px; }
  dd { margin: 0; font-size: 0.95rem; color: var(--ink-soft); }

  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .head { flex-direction: column-reverse; align-items: flex-start; }
    .steps { grid-template-columns: 1fr; }
  }
</style>
