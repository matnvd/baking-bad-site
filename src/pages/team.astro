---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
import { terms, type Officer } from '../data/officers';

// Optional headshots: every image in src/assets/officers/, by filename (any case).
const headshotFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/officers/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', {
  eager: true,
});
const headshots = new Map(
  Object.entries(headshotFiles).map(([path, mod]) => [path.split('/').pop()!.toLowerCase(), mod.default]),
);
const slug = (name: string) =>
  name
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const photoFor = (o: Officer) => {
  if (o.photo) return headshots.get(o.photo.toLowerCase());
  for (const ext of ['jpg', 'jpeg', 'png', 'webp', 'avif']) {
    const hit = headshots.get(`${slug(o.name)}.${ext}`);
    if (hit) return hit;
  }
};

const [current, ...pastTerms] = terms;
const initials = (name: string) =>
  name
    .split(/[\s-]+/)
    .filter(Boolean)
    .map((p) => p[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
const tints = ['var(--apricot)', 'var(--coral)', 'var(--blush)', '#fde3c8'];
---

<Base title="Team" description="Meet the officers who run Baking Bad, Princeton's all-inclusive student baking club.">
  <section class="section intro-sec">
    <div class="wrap head">
      <div>
        <p class="pill">{current.label}</p>
        <h1>The people behind the aprons</h1>
        <p class="muted">They pick the recipes, haul the groceries, book the kitchens, and lead every bake night.</p>
      </div>
      <Mascot class="head-mascot" width={240} />
    </div>
  </section>

  <section class="wrap" aria-label="Current officers">
    <ul class="team">
      {
        current.officers.map((o, i) => (
          <li class="card member">
            <span class="avatar" style={`background:${tints[i % tints.length]}`} aria-hidden="true">
              {photoFor(o) ? (
                <Image src={photoFor(o)!} alt="" width={176} height={176} fit="cover" class="avatar-photo" />
              ) : (
                initials(o.name)
              )}
            </span>
            <span class="name">{o.name}</span>
            <span class="role">{o.role}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    pastTerms.length > 0 && (
      <section class="section" aria-labelledby="past">
        <div class="wrap">
          <h2 id="past">Past teams</h2>
          {pastTerms.map((t) => (
            <div class="term">
              <h3>
                {t.label}
                {t.note && <span class="pill soft">{t.note}</span>}
              </h3>
              <ul class="past-list">
                {t.officers.map((o) => (
                  <li>
                    <span class="name">{o.name}</span> <span class="muted">{o.role}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .intro-sec { padding-bottom: 32px; }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .head h1 { margin-top: 14px; }
  .head p { max-width: 52ch; margin: 0; }
  :global(.head-mascot) { width: clamp(110px, 18vw, 170px); flex: none; }

  .team {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .member {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 16px 22px;
    text-align: center;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    margin-bottom: 14px;
    font-size: 1.5rem;
    font-family: var(--font-display); font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    -webkit-mask: url('/scallop.svg') center / 100% 100% no-repeat;
    mask: url('/scallop.svg') center / 100% 100% no-repeat;
    transition: transform 0.4s var(--ease-out);
  }
  .member:hover .avatar { transform: rotate(-12deg); }
  .avatar :global(.avatar-photo) { width: 100%; height: 100%; object-fit: cover; }
  .name { font-family: var(--font-display); font-weight: 700; line-height: 1.3; }
  .role { margin-top: 2px; font-size: 0.92rem; color: var(--ink-soft); }

  .term { margin-top: 24px; }
  .term h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .past-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 6px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .past-list .name { font-family: var(--font-body); font-weight: 700; }

  @media (max-width: 560px) {
    .head { flex-direction: column-reverse; align-items: flex-start; }
  }
</style>
