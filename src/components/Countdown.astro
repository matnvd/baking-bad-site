---
// Countdown to the next bake. Rendered at build time for the next event,
// then kept honest in the browser: it skips events that have ended (static
// pages go stale) and ticks every second.
// Time known → days / hrs / min / sec. Time TBA → "N days to go".
// The Sign up button stays grayed out until the timer hits zero (events with
// a TBA time never unlock it). Phase 2: point it at the real sign-up flow,
// count down to `signup.opensAt` instead of the start time, and replace
// Date.now() with server time from the signup Worker.
import type { EventView } from '../lib/events';
import { site } from '../data/site';
import ExternalLink from './ExternalLink.astro';

interface Props {
  events: EventView[]; // upcoming, soonest first
}
const { events } = Astro.props;
const next = events[0];
const then = events[1];
const payload = events.map((e) => ({
  title: e.displayTitle,
  start: e.startISO,
  end: e.endISO,
  timeKnown: e.timeKnown,
  longDate: e.longDate,
  meta: [e.dateLabel, e.timeLabel, e.location ?? 'Location TBA'].join(' · '),
}));
---

<section class="countdown card" aria-labelledby="cd-heading" data-events={JSON.stringify(payload)}>
  <div class="cd-live" hidden={!next}>
    <p class="pill next-pill">Next bake<svg class="next-ring" aria-hidden="true"><rect /></svg></p>
    <h2 id="cd-heading" class="cd-title">{next?.displayTitle}</h2>
    <p class="cd-meta">
      {next && <time datetime={next.timeKnown ? next.startISO : next.date}>{next.dateLabel}</time>}
      <span class="cd-rest">{next && ` · ${next.timeLabel} · ${next.location ?? 'Location TBA'}`}</span>
    </p>

    <div class="cd-clock" aria-hidden="true" hidden>
      <div class="tile" data-unit="days"><span class="num">–</span><span class="unit">days</span></div>
      <div class="tile timed" data-unit="hours"><span class="num">–</span><span class="unit">hrs</span></div>
      <div class="tile timed" data-unit="minutes"><span class="num">–</span><span class="unit">min</span></div>
      <div class="tile timed" data-unit="seconds"><span class="num">–</span><span class="unit">sec</span></div>
      <p class="cd-now">Happening now!</p>
    </div>
    <div class="cd-signup">
      <button type="button" class="btn signup-btn" aria-disabled="true" aria-describedby="cd-signup-lock">
        <svg class="lock" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4.5" y="10.5" width="15" height="10.5" rx="2.5" fill="currentColor" stroke="none" />
          <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
        </svg>
        Sign up
      </button>
      <span id="cd-signup-lock" class="sr-only">Locked until the countdown ends</span>
      <p class="signup-note" aria-live="polite"></p>
    </div>
    <p class="cd-then" hidden={!then}>Then: <strong>{then?.displayTitle}</strong> · <span>{then?.dateLabel}</span></p>
  </div>

  <div class="cd-empty" hidden={Boolean(next)}>
    <p class="pill soft">Next bake</p>
    <h2 class="cd-title">Nothing on the calendar yet</h2>
    <p class="cd-meta">
      New bake nights get announced on Instagram first. Follow <ExternalLink href={site.instagram.url}>{site.instagram.handle}</ExternalLink>.
    </p>
  </div>
</section>

<script>
  type Ev = { title: string; start: string; end: string; timeKnown: boolean; longDate: string; meta: string };

  for (const root of document.querySelectorAll<HTMLElement>('.countdown')) {
    const events: Ev[] = JSON.parse(root.dataset.events || '[]');
    const live = root.querySelector<HTMLElement>('.cd-live')!;
    const empty = root.querySelector<HTMLElement>('.cd-empty')!;
    const clock = root.querySelector<HTMLElement>('.cd-clock')!;
    const title = live.querySelector<HTMLElement>('.cd-title')!;
    const time = live.querySelector<HTMLTimeElement>('time');
    const rest = live.querySelector<HTMLElement>('.cd-rest')!;
    const then = live.querySelector<HTMLElement>('.cd-then')!;
    const num = (unit: string) => clock.querySelector<HTMLElement>(`[data-unit="${unit}"] .num`)!;
    const unitLabel = clock.querySelector<HTMLElement>('[data-unit="days"] .unit')!;
    const signup = live.querySelector<HTMLButtonElement>('.signup-btn')!;

    // Size the dashed ring around "Next bake" to the label (a pill shape:
    // corner radius = half its height). CSS animates the dashes around it.
    const DASH_PERIOD = 24; // target dash + gap length in px
    const DASH_SHARE = 0.62; // dash ≈ 15px, gap ≈ 9px
    const ring = live.querySelector<SVGSVGElement>('.next-ring');
    const ringRect = ring?.querySelector('rect');
    const fitRing = () => {
      if (!ring || !ringRect) return;
      const { width, height } = ring.getBoundingClientRect();
      const sw = 2.5;
      const w = Math.max(width - sw, 0);
      const h = Math.max(height - sw, 0);
      ringRect.setAttribute('x', String(sw / 2));
      ringRect.setAttribute('y', String(sw / 2));
      ringRect.setAttribute('width', String(w));
      ringRect.setAttribute('height', String(h));
      ringRect.setAttribute('rx', String(h / 2));
      ringRect.setAttribute('ry', String(h / 2));
      // Fit a whole number of dash+gap repeats around the ring (stretching
      // them slightly), so there's no odd partial dash where the outline
      // starts and the movement loops seamlessly.
      const length = ringRect.getTotalLength?.() || 2 * (w - h) + Math.PI * h;
      if (!length) return;
      const repeats = Math.max(1, Math.round(length / DASH_PERIOD));
      const period = length / repeats;
      ringRect.style.strokeDasharray = `${period * DASH_SHARE} ${period * (1 - DASH_SHARE)}`;
      ringRect.style.setProperty('--period', `${period}px`);
    };
    if (ring) {
      fitRing();
      new ResizeObserver(fitRing).observe(ring);
      document.fonts?.ready.then(fitRing);
    }
    const signupNote = live.querySelector<HTMLElement>('.signup-note')!;
    let shown: Ev | null = null;
    let open = false;

    const setOpen = (isOpen: boolean) => {
      if (isOpen === open) return;
      open = isOpen;
      signup.setAttribute('aria-disabled', String(!isOpen));
      if (isOpen) signup.removeAttribute('aria-describedby');
      else signup.setAttribute('aria-describedby', 'cd-signup-lock');
      signup.classList.toggle('is-open', isOpen);
      signupNote.textContent = '';
    };
    signup.addEventListener('click', () => {
      if (!open) return;
      // TODO(phase 2): go to the real sign-up form.
      signupNote.textContent = 'Online sign-up is coming soon. Watch the GroupMe for the link!';
    });

    // Phase 2 hook: swap for a server-synced clock.
    const now = () => Date.now();

    const show = (ev: Ev) => {
      shown = ev;
      title.textContent = ev.title;
      const [date, ...others] = ev.meta.split(' · ');
      if (time) {
        time.textContent = date;
        time.dateTime = ev.timeKnown ? ev.start : ev.start.slice(0, 10);
      }
      rest.textContent = ' · ' + others.join(' · ');
      clock.classList.toggle('tba', !ev.timeKnown);
      const after = events[events.indexOf(ev) + 1];
      then.hidden = !after;
      if (after) {
        then.querySelector('strong')!.textContent = after.title;
        then.querySelector('span')!.textContent = after.meta.split(' · ')[0];
      }
    };

    const tick = () => {
      const t = now();
      const ev = events.find((e) => Date.parse(e.end) > t);
      if (!ev) {
        live.hidden = true;
        empty.hidden = false;
        return false;
      }
      if (ev !== shown) show(ev);
      clock.hidden = false;

      const ms = Date.parse(ev.start) - t;
      clock.classList.toggle('now', ms <= 0 && ev.timeKnown);
      setOpen(ev.timeKnown && ms <= 0);
      if (ev.timeKnown) {
        const s = Math.max(0, Math.floor(ms / 1000));
        num('days').textContent = String(Math.floor(s / 86400));
        num('hours').textContent = String(Math.floor((s % 86400) / 3600)).padStart(2, '0');
        num('minutes').textContent = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
        num('seconds').textContent = String(s % 60).padStart(2, '0');
        unitLabel.textContent = 'days';
      } else {
        // Time TBA: whole days only. On the day itself, say so.
        const days = Math.ceil(ms / 86400000);
        num('days').textContent = days <= 0 ? 'Today!' : String(days);
        unitLabel.textContent = days <= 0 ? 'time TBA' : days === 1 ? 'day to go' : 'days to go';
      }
      return true;
    };

    if (tick()) setInterval(tick, 1000);
  }
</script>

<style>
  .countdown {
    padding: clamp(24px, 4vw, 36px);
    text-align: center;
    /* soft coral glow so the next bake stands out */
    border-color: #f6c3b4;
    box-shadow:
      0 0 0 1px rgb(248 151 128 / 0.15),
      0 18px 48px -18px rgb(228 112 86 / 0.45),
      var(--shadow);
  }
  /* "NEXT BAKE": deeper coral (cream text 5.1:1) with dashes slowly
     circling it (sized in the script above; still under reduced motion) */
  .next-pill {
    position: relative;
    padding: 0.4em 1.15em;
    background: var(--coral-text);
    font-size: 0.85rem;
  }
  .next-ring {
    position: absolute;
    top: -7px;
    left: -7px;
    width: calc(100% + 14px);
    height: calc(100% + 14px);
    max-width: none; /* the site-wide svg rule caps width at 100% */
    overflow: visible;
    pointer-events: none;
  }
  .next-ring rect {
    fill: none;
    stroke: var(--coral);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 15 9; /* the script fine-tunes these to fit the ring exactly */
    animation: march 1.6s linear infinite;
  }
  @keyframes march {
    to { stroke-dashoffset: calc(-1 * var(--period, 24px)); } /* exactly one dash + gap */
  }
  .cd-title {
    margin: 14px 0 4px;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
  }
  .cd-meta { margin: 0; color: var(--ink-soft); font-weight: 600; }
  /* all four tiles always on one line; they shrink a bit if space is tight */
  .cd-clock {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: clamp(6px, 1.4vw, 14px);
    margin-top: 22px;
  }
  .cd-clock[hidden] { display: none; }
  .tile {
    display: grid;
    place-content: center;
    flex: 0 1 96px;
    min-width: 0;
    aspect-ratio: 1;
    background: var(--apricot);
    -webkit-mask: url('/scallop.svg') center / 100% 100% no-repeat;
    mask: url('/scallop.svg') center / 100% 100% no-repeat;
  }
  .tile:nth-child(2) { background: var(--coral); }
  .tile:nth-child(3) { background: var(--blush); }
  .tile:nth-child(4) { background: #fde3c8; }
  .num {
    font-size: clamp(1.35rem, 4vw, 2.1rem);
    font-family: var(--font-display); font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .unit {
    margin-top: 2px;
    font-size: 0.72rem;
    font-family: var(--font-display); font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* time TBA: one larger tile */
  .tba .timed { display: none; }
  .tba .tile { flex-basis: clamp(124px, 30vw, 150px); }
  .tba .num { font-size: clamp(2.1rem, 6vw, 2.8rem); }
  .cd-signup { margin-top: 20px; }
  .signup-btn {
    min-width: 180px;
    justify-content: center;
    background: var(--coral);
    color: var(--ink);
  }
  /* locked: grayed out until the countdown ends */
  .signup-btn[aria-disabled='true'] {
    background: #ece6e1;
    color: #8f847c;
    border-color: #e2dbd5;
    cursor: not-allowed;
  }
  .signup-btn[aria-disabled='true']:hover { transform: none; }
  .signup-btn.is-open { animation: unlock 0.5s var(--ease-out); }
  .signup-btn.is-open:hover { background: #f6876d; }
  @keyframes unlock {
    0% { transform: scale(0.94); }
    60% { transform: scale(1.06); }
    100% { transform: none; }
  }
  .lock { flex: none; margin-top: -2px; }
  .signup-btn.is-open .lock { display: none; }
  .signup-note { margin: 8px 0 0; font-size: 0.85rem; color: var(--ink-soft); }
  .signup-note:empty { display: none; }
  .cd-then { margin: 18px 0 0; font-size: 0.92rem; color: var(--ink-soft); }
  .cd-then[hidden] { display: none; }
  .cd-now { display: none; margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; }
  .now .tile { display: none; }
  .now .cd-now { display: block; }
</style>
