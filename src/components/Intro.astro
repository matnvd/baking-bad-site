---
// Once-per-session intro: "Baking [photo] Bad" rolls in, the scalloped center
// frame flicks through bake photos while slowly growing, lands on the logo,
// then the same scallop shape opens up as a window that expands to clear the
// whole intro screen, revealing the site underneath.
// Only shown when the inline script in Base.astro adds `html.intro-on`
// (first visit this session, motion allowed, JS on).
import { getImage } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { loaderFrames } from '../lib/photos';

const logoImg = await getImage({ src: logo, width: 240, format: 'webp' });
const frames = [...loaderFrames.map((f) => f.src), logoImg.src];
const letters = (word: string) => [...word];
---

<div class="intro" aria-hidden="true" data-frames={JSON.stringify(frames)}>
  <div class="mark">
    <span class="word top">{letters('Baking').map((ch, i) => <span class="ch" style={`--i:${i}`}><span>{ch}</span></span>)}</span>
    <span class="frame"><img src={frames[0]} alt="" width="240" height="240" loading="lazy" /></span>
    <span class="word bottom">{letters('Bad').map((ch, i) => <span class="ch" style={`--i:${i + 3}`}><span>{ch}</span></span>)}</span>
  </div>
</div>

<script>
  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('.intro');

  if (intro && root.classList.contains('intro-on')) {
    const frames: string[] = JSON.parse(intro.dataset.frames || '[]');
    const frame = intro.querySelector<HTMLElement>('.frame')!;
    const img = frame.querySelector('img')!;
    const FRAME_MS = 65; // time on each photo
    const START_MS = 180; // photos start flicking as the frame pops in
    const HOLD_LOGO_MS = 380; // linger on the logo before the reveal
    const REVEAL_MS = 650; // scallop window expanding to fill the screen
    const SCALE_FROM = 0.78; // frame size right after it pops in…
    const SCALE_TO = 1.22; // …growing to this by the time it reaches the logo
    let finished = false;
    const timers: number[] = [];
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

    const done = () => {
      if (!intro.isConnected) return;
      root.classList.remove('intro-on');
      intro.remove();
      try {
        sessionStorage.setItem('bb-intro', '1');
      } catch {}
    };

    // Cut a scallop-shaped hole in the intro screen, starting exactly where
    // the frame is, and grow it until the whole screen is clear.
    const setHole = (cx: number, cy: number, size: number) => {
      const s = `${size}px ${size}px, 100% 100%`;
      const p = `${cx - size / 2}px ${cy - size / 2}px, 0 0`;
      for (const pre of ['-webkit-', '']) {
        intro.style.setProperty(`${pre}mask-size`, s);
        intro.style.setProperty(`${pre}mask-position`, p);
      }
    };
    const leave = () => {
      if (finished) return;
      finished = true;
      timers.forEach(clearTimeout);
      img.src = frames[frames.length - 1];

      const r = frame.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const from = Math.max(r.width, 1);
      // the scallop's inner edge is ~46.8% of its box, so size it to reach the farthest corner
      const far = Math.hypot(Math.max(cx, innerWidth - cx), Math.max(cy, innerHeight - cy));
      const to = (far / 0.468) * 1.06;
      setHole(cx, cy, from);
      intro.classList.add('reveal');

      const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - t0) / REVEAL_MS, 1);
        setHole(cx, cy, from + (to - from) * ease(t));
        if (t < 1) requestAnimationFrame(tick);
        else done();
      };
      requestAnimationFrame(tick);
      setTimeout(done, REVEAL_MS + 600); // safety net
    };

    const preload = Promise.all(
      frames.map(
        (src) =>
          new Promise<void>((res) => {
            const im = new Image();
            im.onload = im.onerror = () => res();
            im.src = src;
          }),
      ),
    );
    const fonts = document.fonts?.load('1em Pacifico').catch(() => {}) ?? Promise.resolve();
    const timeout = new Promise((res) => setTimeout(res, 1200));

    Promise.race([Promise.all([preload, fonts]), timeout]).then(() => {
      if (finished) return;
      intro.classList.add('play');
      const cycleEnd = START_MS + (frames.length - 1) * FRAME_MS;
      // pop in a bit small, then grow steadily while the photos flick
      frame.animate(
        [
          { transform: 'scale(0)', easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' },
          { transform: `scale(${SCALE_FROM})`, offset: 420 / cycleEnd, easing: 'ease-in-out' },
          { transform: `scale(${SCALE_TO})` },
        ],
        { duration: cycleEnd, delay: 60, fill: 'forwards' },
      );
      frames.forEach((src, i) => later(() => (img.src = src), START_MS + i * FRAME_MS));
      later(leave, cycleEnd + HOLD_LOGO_MS);
    });

    const skip = () => leave();
    intro.addEventListener('click', skip);
    window.addEventListener('keydown', skip, { once: true });
  }
</script>

<style>
  .intro { display: none; }

  :global(html.intro-on) { overflow: hidden; }
  :global(html.intro-on) .intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--cream);
    cursor: pointer;
  }
  /* The reveal: a scallop-shaped hole (first mask layer) knocked out of a
     solid layer, sized/positioned from JS. */
  :global(html.intro-on) .intro.reveal {
    -webkit-mask-image: url('/scallop.svg'), linear-gradient(#000 0 0);
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-composite: xor;
    mask-image: url('/scallop.svg'), linear-gradient(#000 0 0);
    mask-repeat: no-repeat;
    mask-composite: exclude;
    pointer-events: none;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2.4vw, 28px);
    font-family: var(--font-script);
    font-size: clamp(3.4rem, 10vw, 8.5rem);
    line-height: 1;
    color: var(--coral-display);
  }
  .word { display: inline-flex; }
  /* each letter rises out of its own mask */
  .ch {
    display: inline-block;
    /* clip only along the bottom edge so letters rise out of it; Pacifico's
       swashes stay visible on the sides and top */
    clip-path: inset(-1em -0.6em 0 -0.6em);
    padding-bottom: 0.62em; /* deep enough for Pacifico's g descender */
    margin-bottom: -0.62em;
  }
  .ch > span {
    display: inline-block;
    transform: translateY(175%); /* fully below the mask before rising */
  }
  .play .ch > span {
    transform: none;
    transition: transform 0.65s var(--ease-out) calc(var(--i) * 45ms);
  }

  .frame {
    position: relative;
    width: 0.95em;
    aspect-ratio: 1;
    transform: scale(0);
    -webkit-mask: url('/scallop.svg') center / 100% 100% no-repeat;
    mask: url('/scallop.svg') center / 100% 100% no-repeat;
    background: var(--blush);
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 560px) {
    .mark { flex-direction: column; gap: 6px; font-size: clamp(3.6rem, 19vw, 5rem); }
    .frame { width: 1.5em; }
  }
</style>
