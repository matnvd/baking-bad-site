---
// Once-per-session intro: "Baking [photo] Bad" rolls in while the scalloped
// center frame flicks through bake photos, growing exponentially. It lands on
// the logo and, without stopping, keeps growing into a window that clears the
// whole intro screen and reveals the site underneath.
// Only shown when the inline script in Base.astro adds `html.intro-on`
// (first visit this session, motion allowed, JS on).
import { getImage } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { loaderFrames } from '../lib/photos';

const logoImg = await getImage({ src: logo, width: 240, format: 'webp' });
const frames = [...loaderFrames.map((f) => f.src), logoImg.src];
const letters = (word: string) => [...word];
---

<div class="intro" aria-hidden="true" data-frames={JSON.stringify(frames)}>
  <div class="mark">
    <span class="word top">{letters('Baking').map((ch, i) => <span class="ch" style={`--i:${i}`}><span>{ch}</span></span>)}</span>
    <span class="frame"><img src={frames[0]} alt="" width="240" height="240" loading="lazy" /></span>
    <span class="word bottom">{letters('Bad').map((ch, i) => <span class="ch" style={`--i:${i + 3}`}><span>{ch}</span></span>)}</span>
  </div>
</div>

<script>
  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('.intro');

  if (intro && root.classList.contains('intro-on')) {
    const frames: string[] = JSON.parse(intro.dataset.frames || '[]');
    const logoSrc = frames[frames.length - 1];
    const frame = intro.querySelector<HTMLElement>('.frame')!;
    const img = frame.querySelector('img')!;

    const FRAME_MS = 45; // time on each photo
    const LOGO_MS = 120; // logo visible (and still growing) before the screen starts clearing
    const REVEAL_MS = 520; // window grows from frame size to fill the screen
    const SIZE_START = 0.6; // frame size when photos start, × its normal size
    const RATE_START = 0.7; // initial growth rate (per second, in log space: ~+23% in 0.3s)
    const CURVE = 8; // how sharply growth accelerates toward the end

    let finished = false;
    let raf = 0;
    let clone: HTMLElement | null = null;
    const timers: number[] = [];

    const done = () => {
      if (!intro.isConnected) return;
      cancelAnimationFrame(raf);
      timers.forEach(clearTimeout);
      clone?.remove();
      root.classList.remove('intro-on');
      intro.remove();
      try {
        sessionStorage.setItem('bb-intro', '1');
      } catch {}
    };

    // Scallop-shaped hole in the intro screen (see .reveal in the styles).
    const setHole = (cx: number, cy: number, size: number) => {
      const s = `${size}px ${size}px, 100% 100%`;
      const p = `${cx - size / 2}px ${cy - size / 2}px, 0 0`;
      for (const pre of ['-webkit-', '']) {
        intro.style.setProperty(`${pre}mask-size`, s);
        intro.style.setProperty(`${pre}mask-position`, p);
      }
    };

    // One continuous size curve from the first photo to a full-screen window:
    //   ln(size) = ln(start) + RATE_START·t + B·t^CURVE      (t in seconds)
    // i.e. exponential growth from the start that keeps accelerating, with B
    // solved so it exactly fills the screen at the end. Never pauses.
    // The reveal phase is carried by a copy of the logo frame sitting above
    // the intro screen, with a matching hole in the screen underneath; the
    // copy fades out while both keep growing, so the site shows through.
    const start = () => {
      const base = frame.offsetWidth;
      const r = frame.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      // the scallop's inner edge is ~46.8% of its box: size it past the farthest corner
      const cover = (Math.hypot(Math.max(cx, innerWidth - cx), Math.max(cy, innerHeight - cy)) / 0.468) * 1.06;

      const cycleEnd = (frames.length - 1) * FRAME_MS; // when the logo appears
      let revealAt = cycleEnd + LOGO_MS;
      const total = (revealAt + REVEAL_MS) / 1000;
      const s0 = SIZE_START * base;
      let A = RATE_START;
      let B = (Math.log(cover / s0) - A * total) / total ** CURVE;
      if (B < 0) {
        // tiny screens: plain exponential is already enough
        A = Math.log(cover / s0) / total;
        B = 0;
      }
      let sizeAt = (t: number) => s0 * Math.exp(A * (t / 1000) + B * (t / 1000) ** CURVE);

      frames.forEach((src, i) => timers.push(window.setTimeout(() => (img.src = src), i * FRAME_MS)));

      const beginReveal = () => {
        img.src = logoSrc;
        clone = document.createElement('div');
        clone.setAttribute('aria-hidden', 'true');
        clone.style.cssText = `position:fixed;left:${cx - base / 2}px;top:${cy - base / 2}px;width:${base}px;height:${base}px;z-index:1001;pointer-events:none;background:var(--blush);will-change:transform,opacity`;
        for (const pre of ['-webkit-', '']) clone.style.setProperty(`${pre}mask`, "url('/scallop.svg') center / 100% 100% no-repeat");
        const ci = document.createElement('img');
        ci.src = logoSrc;
        ci.alt = '';
        ci.style.cssText = 'display:block;width:100%;height:100%;object-fit:cover';
        clone.append(ci);
        document.body.append(clone);
        frame.style.visibility = 'hidden';
        intro.classList.add('reveal');
      };

      const t0 = performance.now();
      const tick = (now: number) => {
        const t = now - t0;
        const size = sizeAt(t);
        if (t < revealAt) {
          frame.style.transform = `scale(${size / base})`;
          frame.style.opacity = String(Math.min(t / 120, 1)); // quick fade-in
        } else {
          if (!clone) beginReveal();
          const v = (t - revealAt) / REVEAL_MS;
          setHole(cx, cy, size);
          clone!.style.transform = `scale(${size / base})`;
          clone!.style.opacity = String(1 - Math.min(v / 0.55, 1) ** 2);
          if (v >= 1) return done();
        }
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);

      // Skipping (tap/any key) starts the reveal right away from the current
      // size and growth rate, so it speeds up instead of jumping or stalling.
      skipNow = () => {
        if (clone || finished) return;
        timers.forEach(clearTimeout);
        const t = performance.now() - t0;
        const ts = t / 1000;
        const sNow = sizeAt(t);
        const rate = A + CURVE * B * ts ** (CURVE - 1);
        const R = REVEAL_MS / 1000;
        const B2 = Math.max(0, (Math.log(cover / sNow) - rate * R) / R ** 3);
        sizeAt = (u: number) => (u < t ? sNow : sNow * Math.exp(rate * ((u - t) / 1000) + B2 * ((u - t) / 1000) ** 3));
        revealAt = t;
      };
      timers.push(window.setTimeout(done, revealAt + REVEAL_MS + 1500)); // safety net
    };

    let skipNow: () => void = () => {
      finished = true; // skipped before it even started
      done();
    };

    const preload = Promise.all(
      frames.map(
        (src) =>
          new Promise<void>((res) => {
            const im = new Image();
            im.onload = im.onerror = () => res();
            im.src = src;
          }),
      ),
    );
    const fonts = document.fonts?.load('1em Pacifico').catch(() => {}) ?? Promise.resolve();
    const timeout = new Promise((res) => setTimeout(res, 1200));

    Promise.race([Promise.all([preload, fonts]), timeout]).then(() => {
      if (finished) return;
      intro.classList.add('play');
      start();
    });

    const skip = () => skipNow();
    intro.addEventListener('click', skip);
    window.addEventListener('keydown', skip, { once: true });
  }
</script>

<style>
  .intro { display: none; }

  :global(html.intro-on) { overflow: hidden; }
  :global(html.intro-on) .intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--cream);
    cursor: pointer;
  }
  /* The reveal: a scallop-shaped hole (first mask layer) knocked out of a
     solid layer, sized/positioned from JS. */
  :global(html.intro-on) .intro.reveal {
    -webkit-mask-image: url('/scallop.svg'), linear-gradient(#000 0 0);
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-composite: xor;
    mask-image: url('/scallop.svg'), linear-gradient(#000 0 0);
    mask-repeat: no-repeat;
    mask-composite: exclude;
    pointer-events: none;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2.4vw, 28px);
    font-family: var(--font-script);
    font-size: clamp(3.4rem, 10vw, 8.5rem);
    line-height: 1;
    color: var(--coral-display);
  }
  .word { display: inline-flex; }
  /* each letter rises out of its own mask */
  .ch {
    display: inline-block;
    /* clip only along the bottom edge so letters rise out of it; Pacifico's
       swashes stay visible on the sides and top */
    clip-path: inset(-1em -0.6em 0 -0.6em);
    padding-bottom: 0.62em; /* deep enough for Pacifico's g descender */
    margin-bottom: -0.62em;
  }
  .ch > span {
    display: inline-block;
    transform: translateY(175%); /* fully below the mask before rising */
  }
  .play .ch > span {
    transform: none;
    transition: transform 0.45s var(--ease-out) calc(var(--i) * 30ms);
  }

  .frame {
    position: relative;
    width: 0.95em;
    aspect-ratio: 1;
    transform: scale(0);
    -webkit-mask: url('/scallop.svg') center / 100% 100% no-repeat;
    mask: url('/scallop.svg') center / 100% 100% no-repeat;
    background: var(--blush);
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 560px) {
    .mark { flex-direction: column; gap: 6px; font-size: clamp(3.6rem, 19vw, 5rem); }
    .frame { width: 1.5em; }
  }
</style>
