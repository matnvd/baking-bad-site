# Credentials for `npm run photos:upload`. Copy this file to .env (gitignored)
# and fill in ONE of the two options. Step-by-step: README → "One-time Cloudflare setup".

# Your Cloudflare account ID (32 letters/numbers; it's in the dashboard URL:
# dash.cloudflare.com/<account-id>/...).
R2_ACCOUNT_ID=

# Option 1 (simplest): a Cloudflare API token with R2 edit/write permission.
CLOUDFLARE_API_TOKEN=

# Option 2: the S3-style key pair that R2's own token page shows after creating a token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET=bakingbad-media
